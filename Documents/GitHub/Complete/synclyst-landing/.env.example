# Mobile signup API (Vercel → Project Settings → Environment Variables)
# Copy the same values used on app.synclyst.app where applicable.

# Clerk — create accounts (Dashboard → API Keys → Secret key)
CLERK_SECRET_KEY=sk_live_xxx

# Resend — send desktop install emails (https://resend.com)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=SyncLyst <hello@synclyst.app>

# Supabase — optional lead logging (same as waitlist / app)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
